# Planeación interna del equipo (no versionar)
docs/privado/

# Entorno y caché de Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Datos derivados: se regeneran con scripts/.
# data/raw SÍ se versiona (fuentes públicas con licencia abierta), porque los
# portales pueden bloquear descargas automáticas; ver data/README.md.
data/raw/*.part
data/interim/*
data/processed/*
!data/interim/.gitkeep
!data/processed/.gitkeep

# Sistema operativo y editores
.DS_Store
Thumbs.db
.vscode/
.idea/
